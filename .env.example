APP_ENV=development
APP_NAME=AI Company OS
POSTGRES_DB=ai_company
POSTGRES_USER=ai_company
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+asyncpg://ai_company:replace-with-a-long-random-database-password@db:5432/ai_company
REDIS_URL=redis://redis:6379/0
TASK_EXECUTION_MODE=worker
CELERY_CONCURRENCY=2
AUTO_CREATE_SCHEMA=false
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRACING_ENABLED=false
OPENAI_STORE_RESPONSES=false
OPENAI_MONTHLY_BUDGET_USD=10.0
REVIEW_MAX_REWORKS=1
TASK_MAX_ATTEMPTS=3
TASK_TIMEOUT_SECONDS=600
DELEGATION_MAX_DEPTH=3
DELEGATION_MAX_CHILDREN=5
DELEGATION_MAX_TOKEN_BUDGET=50000
DELEGATION_MAX_TIMEOUT_SECONDS=900
DELEGATION_MAX_COST_USD=5.0
DELEGATION_APPROVAL_COST_THRESHOLD_USD=1.0
DELEGATION_APPROVAL_ROLES=legal_review
DELEGATION_DISPATCH_STALE_SECONDS=300
DELEGATION_RECOVERY_GRACE_SECONDS=120
ATTENTION_TASK_STALE_SECONDS=1200
ATTENTION_COMMITMENT_DECISION_HOURS=24
ATTENTION_COMMITMENT_CRITICAL_HOURS=72
ATTENTION_APPROVAL_CRITICAL_HOURS=72
ATTENTION_AUTO_PLAN_ENABLED=false
ATTENTION_AUTO_PLAN_INTERVAL_SECONDS=300
ATTENTION_AUTO_PLAN_LIMIT=20
AUTH_ENABLED=true
APP_API_KEY=replace-with-at-least-32-random-characters
DEFAULT_TENANT_ID=owner
CORS_ORIGINS=http://localhost:8000
PUBLIC_BASE_URL=http://localhost:8000
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=
BRIEFING_ENABLED=false
BRIEFING_TIMEZONE=Asia/Seoul
BRIEFING_HOUR=7
BRIEFING_MINUTE=0
BRIEFING_CATCHUP_HOURS=3
BRIEFING_QUIET_START_HOUR=22
BRIEFING_QUIET_END_HOUR=7
BRIEFING_MAX_ATTEMPTS=3
BRIEFING_RETRY_SECONDS=300
BRIEFING_DELIVERY_LEASE_SECONDS=600
